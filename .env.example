# ============================================================================
# Glass-Box ATS Simulator & Optimization Studio — Environment Configuration
# Copy this file to `.env` for custom local or production deployments.
# ============================================================================

# FastAPI Backend Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_BYTES=10485760
RATE_LIMIT_RPM=120

# PostgreSQL 16 + pgvector Connection String (used in Docker Compose or cloud DB)
DATABASE_URL=postgresql://glassbox:glassbox_secret@localhost:5432/glassbox_ats

# Next.js Frontend Public API Endpoint
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
